      # ↑ আজকে সকাল ১০:০০:০০ BD time

      due_date = if today < cutoff_time
      # ↑ IF AS EXPRESSION — Ruby-তে if value return করতে পারে!
      # ↑ Python-এ: due_date = date if now.hour < 10 else next_day

                   date
