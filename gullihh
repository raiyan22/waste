      def id
        "#{@feed}-#{@entry['package']}-#{@entry['new_version']}"
        # Example: "my-project-lodash-4.17.21"
      end

      def url
        @entry['url'] || @entry['changelog_url'] || ''
      end

      def title
        "#{@entry['package']} #{@entry['current_version']} → #{@entry['new_version']}"
        # Example: "lodash 4.17.20 → 4.17.21"
      end

      def identifier
        "#{@entry['package']}-#{@entry['new_version']}"
      end

      def date
        @entry['timestamp'] || Time.now.to_s
      end

      def ignore?
        !!(title =~ IGNORE_REGEXP)
        # Base-এর regex ব্যবহার করো (alpha/beta/rc filter)
        # অথবা override করো তোমার logic অনুযায়ী
      end
    end
  end
end
```

