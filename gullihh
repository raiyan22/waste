### File 2: `lib/gulli.rb`

```ruby
require 'logger'
# ↑ REQUIRE: Ruby-র built-in Logger library (console-এ log লেখার জন্য)

require 'gulli/collect_rss_articles'
# ↑ REQUIRE: lib/gulli/collect_rss_articles.rb file load করো

require 'gulli/collect_dependabot_alerts'
# ↑ REQUIRE: lib/gulli/collect_dependabot_alerts.rb file load করো

require 'gulli/collect_google_artifact_registry_alerts'
# ↑ REQUIRE: lib/gulli/collect_google_artifact_registry_alerts.rb file load করো

module Gulli
# ↑ MODULE শুরু: "Gulli" নামের একটা বাক্স/namespace তৈরি করছি
# ↑ এর ভিতরের সব কিছু Gulli.xyz দিয়ে access হবে

  FEED_ENTRY_COLLECTOR = {
  # ↑ CONSTANT (বড় হাতের নাম = constant, পরে change করা যাবে না)
  # ↑ TYPE: Hash (Python-এর dictionary)
  # ↑ PURPOSE: feed type দেখে কোন collector class ব্যবহার করবো — lookup table

    'rss' => Gulli::CollectRSSArticles,
    # ↑ KEY: 'rss' (string)
    # ↑ => : key-value separator (Python-এ : ব্যবহার হয়)
    # ↑ VALUE: CollectRSSArticles CLASS (object না, class নিজেই)
    # ↑ :: : namespace separator (Python-এ . ব্যবহার হয়)
    # ↑ মানে: type "rss" হলে CollectRSSArticles class ব্যবহার করো

    'dependabot' => Gulli::CollectDependabotAlerts,
    # ↑ type "dependabot" হলে CollectDependabotAlerts class ব্যবহার করো

    'google-artifact-registry' => Gulli::CollectGoogleArtifactRegistryAlerts,
    # ↑ type "google-artifact-registry" হলে এই class ব্যবহার করো
  }.freeze
  # ↑ .freeze = METHOD: এই dictionary-কে immutable (unchangeable) করো


  def self.run
  # ↑ METHOD DEFINITION
  # ↑ self. = MODULE METHOD (object ছাড়া call করা যায়: Gulli.run)
  # ↑ Python-এ: @staticmethod def run():

    clear_cache!
    # ↑ METHOD CALL: Gulli.clear_cache! (নিচে defined)
    # ↑ ! = convention: "এটা কিছু change/delete করে"
    # ↑ কাজ: আগের cached data মুছে ফেলো, fresh start

    announcements.each do |announcement|
    # ↑ announcements = METHOD CALL: Gulli.announcements (নিচে defined)
    #   returns: সব feed-এর সব articles-এর array
    # ↑ .each = METHOD: array-র প্রতিটা item-এ loop চালাও
    # ↑ do = BLOCK শুরু (Python-এর for loop body শুরু)
    # ↑ |announcement| = BLOCK PARAMETER (Python-এর loop variable)
    # ↑ পুরো line = Python-এর: for announcement in announcements:

      handle_announcement(announcement)
      # ↑ METHOD CALL: এই announcement handle করো (নিচে defined)
    end
    # ↑ BLOCK END (do-র pair)

  rescue StandardError => error
  # ↑ EXCEPTION HANDLER (Python-এর except)
  # ↑ StandardError = Ruby-র base exception (Python-এর Exception)
  # ↑ => error = caught exception-কে 'error' variable-এ রাখো
  # ↑ Python-এ: except Exception as error:
  # ↑ NOTE: rescue পুরো method body-কে try-catch করে

    Gulli.logger.fatal error
    # ↑ fatal = সবচেয়ে serious log level

    Gulli::Notify.fatal "#{error.class} #{error}"
    # ↑ Gulli::Notify = Notify CLASS (Gulli module-এর ভিতরে)
    # ↑ .fatal = Notify-র METHOD (Slack-এ crash message পাঠায়)
    # ↑ "#{...}" = STRING INTERPOLATION (Python-এর f"..." এর মতো)
    # ↑ error.class = exception-এর type (যেমন RuntimeError)
  end
  # ↑ METHOD END


  def self.feeds
  # ↑ MODULE METHOD: feed list return করে

    feeds = Gulli::FetchFeeds.call
    # ↑ LOCAL VARIABLE = feeds
    # ↑ FetchFeeds = CLASS
    # ↑ .call = CLASS METHOD
    # ↑ কাজ: Google Sheet থেকে feed list পড়ে
    # ↑ returns: [{name: "nginx", url: "...", type: "rss"}, ...]

    Gulli.logger.info "Got #{feeds.length} feeds"
    # ↑ log-এ লেখো কতগুলো feed পেয়েছি
    # ↑ feeds.length = array-র length (Python: len(feeds))

    feeds
    # ↑ IMPLICIT RETURN: Ruby-তে last line automatically return হয়
    # ↑ Python-এ: return feeds লিখতে হতো
  end


  def self.announcements
  # ↑ MODULE METHOD: সব feed থেকে সব articles collect করে return

    feeds.each_with_object([]) do |feed, announcements|
    # ↑ feeds = METHOD CALL: Gulli.feeds (উপরের method)
    # ↑ .each_with_object([]) = METHOD:
    #     [] = empty array (accumulator) দিয়ে শুরু
    #     প্রতিটা iteration-এ এই array pass হয়
    #     শেষে এই array return হয়
    # ↑ do |feed, announcements| = BLOCK with 2 PARAMETERS
    #     feed = current feed from feeds array
    #     announcements = accumulator (সেই [] যেটা দিয়ে শুরু করেছি)
    # ↑ Python-এ:
    #     result = []
    #     for feed in self.feeds():
    #         ...
    #     return result

      collector = FEED_ENTRY_COLLECTOR[feed[:type]]
      # ↑ LOCAL VARIABLE
      # ↑ FEED_ENTRY_COLLECTOR[...] = dictionary lookup
      # ↑ feed[:type] = feed hash থেকে :type key-র value
      #   :type = SYMBOL (হালকা string, Python-এ "type")
      # ↑ collector এখন একটা CLASS
      #   যেমন: feed[:type] = "rss" → collector = CollectRSSArticles

      announcements.concat(collector.call(feed))
      # ↑ collector.call(feed) = CLASS METHOD CALL
      #   যেমন: CollectRSSArticles.call(feed)
      #   returns: [RSSArticle1, RSSArticle2, ...]
      # ↑ .concat = METHOD: array-তে অন্য array-র সব items add করো
      #   Python-এ: list.extend(other_list)
    end
  end


  def self.handle_announcement(announcement)
  # ↑ MODULE METHOD
  # ↑ PARAMETER: announcement = একটা feed entry object
  #   (RSSArticle, Dependabot, বা GoogleArtifactRegistry)

    if already_known_or_old?(announcement)
    # ↑ METHOD CALL: নিচে defined
    # ↑ ? = convention: boolean return করে

      Gulli.logger.debug "Ignoring #{announcement.id} as we already know it"
      # ↑ announcement.id = INSTANCE METHOD call
      #   প্রতিটা article type আলাদা ভাবে id বানায়

      return
      # ↑ EARLY RETURN: method থেকে বের হয়ে যাও
      # ↑ বাকি code execute হবে না
    end

    if !announcement.ignore? && announcement.auto_jira_issue_create?
    # ↑ ! = NOT operator
    # ↑ announcement.ignore? = "ignore করবো কি?" (true/false)
    #   !ignore? = "ignore করবো না" = "important!"
    # ↑ && = AND operator (Python-এ and)
    # ↑ auto_jira_issue_create? = "auto JIRA ticket চালু আছে কি?"
    # ↑ পুরো condition: "important AND jira enabled"

      # announcement.create_jira_ticket!(article: announcement) ###########
      # ↑ COMMENTED OUT (# দিয়ে) — DRY RUN mode-এ আসল JIRA call হয় না

      puts " [DRY RUN] Would create JIRA ticket for: #{announcement.title}"
      # ↑ puts = BUILT-IN: print to console (Python-এর print())
    end

    Gulli.logger.debug "#{announcement.id} is unknown, remembering it"

    # announcement.remember! unless announcement.published_date_before_6_months? ######
    # ↑ COMMENTED OUT — DRY RUN mode
    # ↑ unless = "if not" → "৬ মাসের পুরনো না হলে Sheet-এ save করো"
    # ↑ remember! = Sheet-এ নতুন row append

    puts " [DRY RUN] Would UPDATE Google Sheet (mark as seen): #{announcement.id}"

    # Gulli::Notify.article(announcement) unless announcement.ignore? #######
    # ↑ COMMENTED OUT — DRY RUN mode
    # ↑ "ignore করার মতো না হলে Slack-এ notify করো"

    puts " [DRY RUN] Would send SLACK notification for: #{announcement.title}"
  end


  def self.already_known_or_old?(announcement)
  # ↑ MODULE METHOD
  # ↑ ? = boolean return
  # ↑ PURPOSE: "এটা কি আগে থেকে জানি বা পুরনো?"

    announcement.known? || announcement.published_date_before_6_months?
    # ↑ || = OR operator (Python-এ or)
    # ↑ known? = "Sheet-এ আছে?" (true/false)
    # ↑ published_date_before_6_months? = "৬ মাসের পুরনো?" (true/false)
    # ↑ যেকোনো একটা true → পুরো expression true
    # ↑ SHORT-CIRCUIT: known? true হলে দ্বিতীয়টা check-ই হবে না
    # ↑ IMPLICIT RETURN: এই expression-এর result return হবে
  end


  def self.config
  # ↑ MODULE METHOD
  # ↑ PURPOSE: সব configuration একটা dictionary-তে

    @config ||= {
    # ↑ @config = INSTANCE VARIABLE (module level-এ)
