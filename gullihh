    def fetch_image_data
    # ↑ PRIVATE METHOD: Google API call

      response = HTTPClient.new.get(url, nil, headers)
      # ↑ url = ATTR_READER (নিচে)
      # ↑ nil = no query params
      # ↑ headers = PRIVATE METHOD with OAuth2 token

      handle_bad_response(response)
      # ↑ error check → fail হলে exception raise

      JSON.parse(response.body)

    rescue StandardError => error
      handle_unexpected_error(error)
    end

    def handle_bad_response(response)
      return if response.status < 400
      # ↑ 200-399 = OK → কিছু করো না, return

      notify_docker_error("Error fetching image info: Status #{response.status}: #{response.body}")
      fail "HTTP error: #{response.status}"
      # ↑ fail = KEYWORD: exception raise করো (= raise in Python)
    end

    def handle_unexpected_error(error)
      notify_docker_error("Unexpected error: #{error.message}")
      fail error
      # ↑ fail error = same exception আবার raise (re-raise)
    end


    def parse_and_filter_image_data
    # ↑ PRIVATE METHOD: মূল logic

      data = fetch_image_data
      # ↑ API call → response data

      return [] unless valid_image_data?(data)
      # ↑ valid না? → empty array

      digest, info = find_latest_image(data['manifest'])
      # ↑ MULTIPLE ASSIGNMENT (Python-এও same: a, b = func())
      # ↑ digest = image hash (e.g., "sha256:deadbeef")
      # ↑ info = manifest info (tags, upload time, etc.)

      return [] unless digest && info
      # ↑ "latest" tag পাওয়া যায়নি → empty

      build_alert_entry(digest, info)
    end

    def headers
      { 'Authorization' => "Bearer #{fetch_google_access_token}" }
      # ↑ OAuth2 Bearer token
    end

    attr_reader :url
    # ↑ ATTR_READER: @url-এর getter method auto-generate
    # ↑ effectively: def url; @url; end


    def fetch_google_access_token
    # ↑ PRIVATE METHOD
    # ↑ PURPOSE: keyfile.json → Google API access token

      scope = ['https://www.googleapis.com/auth/cloud-platform']

      authorizer = Google::Auth::ServiceAccountCredentials.make_creds(
        json_key_io: File.open(Gulli.config[:google][:keyfile]),
        # ↑ তোমার keyfile.json!
        scope: scope,
      )

      authorizer.fetch_access_token!['access_token']
      # ↑ .fetch_access_token! = Google-এ network call করে token আনে
      # ↑ ! = side effect (network call)
      # ↑ returns: {"access_token" => "ya29.xxx..."} hash
      # ↑ ['access_token'] = hash থেকে token string বের করো
    end


    def valid_image_data?(image_data)
      image_data.is_a?(Hash) && image_data['manifest'].is_a?(Hash)
      # ↑ .is_a?(Hash) = TYPE CHECK (Python-এ: isinstance(x, dict))
    end

    def find_latest_image(manifests)
    # ↑ PURPOSE: "latest" tag-ওয়ালা image খোঁজো

      manifests.detect { |_, m| m['tag'].include?('latest') }
      # ↑ .detect = METHOD (= .find)
      #     প্রথম match পেলে return, না পেলে nil
      # ↑ { |_, m| ... } = BLOCK
      #     |_, m| = 2 PARAMS: key (ignored with _), value
      #     _ = convention: "এই value দরকার নেই, ignore করো"
      # ↑ m['tag'] = tag array, e.g., ["latest", "v1.0"]
      # ↑ .include?('latest') = "latest" আছে কি?
    end

    def build_alert_entry(digest, info)
      [{
        'image' => digest,
        'uploaded_at' => format_uploaded_time(info),
        'url' => parse_marketplace_url(@url),
      }]
      # ↑ Array with single Hash
      # ↑ .map দিয়ে process করার জন্য array-তে wrap
    end

    def format_uploaded_time(info)
      Time.at(info['timeUploadedMs'].to_i / 1000).utc.strftime('%Y-%m-%d %H:%M:%S UTC')
      # ↑ info['timeUploadedMs'] = "1705312200000" (milliseconds string)
      # ↑ .to_i = string → integer
      # ↑ / 1000 = milliseconds → seconds
      # ↑ Time.at(seconds) = Unix timestamp → Time object
      # ↑ .utc = UTC timezone-এ convert
      # ↑ .strftime = format → "2024-01-15 10:30:00 UTC"
    end

    def parse_marketplace_url(feed)
    # ↑ API URL → readable URL

      uri = URI.parse(feed)
      path_parts = uri.path.split('/')
      host = uri.host
      owner = path_parts[2]
      repo = path_parts[3]
      "#{host}/#{owner}/#{repo}"
      # ↑ "https://gcr.io/v2/google/image/tags/list" → "gcr.io/google/image"

    rescue StandardError
      feed
      # ↑ error হলে original URL return
    end
  end
end
