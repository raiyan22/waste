### 3.8 `lib/gulli/collect_google_artifact_registry_alerts.rb` — GAR

```ruby
def parse_and_filter_image_data
  data = fetch_image_data                          # API call
  return [] unless valid_image_data?(data)         # valid response?
  
  digest, info = find_latest_image(data['manifest'])  # "latest" tag খোঁজো
  return [] unless digest && info
  
  build_alert_entry(digest, info)                  # alert object বানাও
