**Collector-এ parse করে Gulli-friendly hash বানাও:**
```ruby
def fetch_renovate_report
  # Renovate JSON পড়ো
  report = JSON.parse(HTTPClient.new.get_content(@url))

  # Gulli-friendly format-এ convert করো
  report['updates'].map do |update|
    {
      'package'         => update['depName'],
      'current_version' => update['currentVersion'],
      'new_version'     => update['newVersion'],
      'update_type'     => update['updateType'],
      'url'             => update['changelogUrl'],
      'timestamp'       => Time.now.to_s,
      'vulnerabilities' => update['vulnerabilityAlerts'],
    }
  end
end
```

